# Copy to .env (git-ignored) and replace every change-me. Placeholders only: never commit real values.
# The client (Vite) reads no environment variable; everything below is read by the server, tests or seed.

# PostgreSQL connection of the app. Use the password you gave the local slotbook role. Cloud Run: Secret Manager.
DATABASE_URL=postgresql://slotbook:change-me@localhost:5432/slotbook
# Separate test database (name must end in _test); used by npm test and npm run test:e2e only.
DATABASE_URL_TEST=postgresql://slotbook:change-me@localhost:5432/slotbook_test
# Signs the session cookie. Production: 32+ random characters, never this placeholder, or the server refuses to start.
SESSION_SECRET=change-me-at-least-32-characters-long
# HTTP port. Cloud Run sets it; locally 3000 (the Vite dev server proxies /api to it).
PORT=3000
# development locally; test is set by the test runners; Cloud Run uses production.
NODE_ENV=development
# Password of every seeded demo account. Never printed. Cloud Run: Secret Manager.
SEED_PASSWORD=change-me

# Docker Compose only: password of the slotbook role in the compose database (letters and digits).
POSTGRES_PASSWORD=change-me

# Production only: the seed writes demo accounts only when this is "true" (Lab 6 UAT). Ignored elsewhere.
# SEED_DEMO_DATA=false
# Production only: folder of the built SPA that Express serves. Default: client/dist of this repository.
# CLIENT_DIST=/app/client/dist
# Commit shown by GET /api/version and the footer. Cloud Run: set by deploy/release.sh on every deploy. Default: local.
# APP_COMMIT=local
